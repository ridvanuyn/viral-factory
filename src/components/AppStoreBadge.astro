---
/** App Store badge — the app is live, this always links to the real listing. */
import { STORE } from '../config/site';
interface Props { class?: string; label?: string; sublabel?: string }
const { class: className = '', label = 'Download on the', sublabel = 'App Store' } = Astro.props;
---
<a
  href={STORE.appStoreUrl}
  class:list={['inline-flex items-center gap-2.5 rounded-xl bg-ink px-4 py-2.5 text-bg transition-transform hover:scale-[1.02]', className]}
  rel="noopener"
>
  <svg viewBox="0 0 384 512" class="h-5 w-5 fill-current" aria-hidden="true"><path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141 0 184.3 0 272.9c0 25.7 4.7 52.3 14.1 79.6 12.5 36.7 57.6 126.7 104.7 125.2 24.7-.6 42.1-17.5 74.2-17.5 31.2 0 47.3 17.5 74.9 17.5 47.5-.7 88.2-82.5 100.1-119.3-63.6-30-63.3-88-49.3-89.7zM256.4 88.9c26.7-31.8 24.3-60.7 23.6-71.1-23.7 1.4-51.1 16.4-66.8 34.9-17.3 19.8-27.5 44.4-25.4 71.5 25.5 2 48.7-10.4 68.6-35.3z"/></svg>
  <span class="text-left leading-tight"><span class="block text-[10px] font-medium">{label}</span><span class="block text-sm font-bold">{sublabel}</span></span>
</a>
