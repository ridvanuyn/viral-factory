---
import { BRAND, STORE, DEFAULT_LOCALE, ACTIVE_LOCALES, LOCALE_NAMES, type Locale } from '../config/site';
import { t, lp, alternates } from '../i18n';

interface Props { lang?: Locale; path?: string; hideSwitcher?: boolean }
const { lang = DEFAULT_LOCALE, path = '/', hideSwitcher = false } = Astro.props;
const tr = t(lang);
const nav = [
  { href: `${lp(lang, '/')}#features`, label: tr.nav.features },
  { href: lp(lang, '/support'), label: tr.nav.support },
];
const langs = alternates(path);
const showSwitcher = !hideSwitcher && ACTIVE_LOCALES.length > 1;
---
<header class="sticky top-0 z-50 border-b border-line bg-bg/90 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href={lp(lang, '/')} class="flex items-center gap-2.5 font-bold text-ink" aria-label={`${BRAND.name} home`}>
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-accent text-sm text-white">VF</span>
      <span class="font-display text-lg tracking-tight">{BRAND.name}</span>
    </a>
    <nav class="hidden items-center gap-7 md:flex" aria-label="Primary">
      {nav.map((n) => (
        <a href={n.href} class="text-sm font-semibold text-ink-soft transition-colors hover:text-ink">{n.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      {showSwitcher && (
        <div class="group relative hidden sm:block">
          <button class="flex items-center gap-1 rounded-pill border border-line-strong px-3 py-2 text-sm font-semibold text-ink-soft hover:text-ink" aria-label={tr.lang}>
            <span aria-hidden="true">&#9673;</span> <span class="uppercase">{lang}</span>
          </button>
          <div class="invisible absolute right-0 z-10 mt-1 max-h-96 w-44 overflow-y-auto rounded-xl border border-line bg-bg-raised p-1 opacity-0 shadow-lg transition-all group-hover:visible group-hover:opacity-100">
            {langs.map((l) => (
              <a href={l.href} class:list={['block rounded-lg px-3 py-2 text-sm hover:bg-black/[0.04]', l.lang === lang ? 'font-bold text-ink' : 'text-ink-soft']}>{LOCALE_NAMES[l.lang]}</a>
            ))}
          </div>
        </div>
      )}
      <a href={STORE.appStoreUrl} rel="noopener" class="btn-cta px-5 py-2.5 text-sm">{tr.cta.getApp}</a>
    </div>
  </div>
</header>
