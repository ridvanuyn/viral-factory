---
import LegalDocBody from '../../sections/LegalDocBody.astro';
import { legal } from '../../i18n/legal';
import { t } from '../../i18n';
import { ACTIVE_LOCALES, type Locale } from '../../config/site';

export function getStaticPaths() {
  return ACTIVE_LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Locale };
const tr = t(lang);
const doc = legal[lang]?.privacy ?? legal.en.privacy;
---
<LegalDocBody lang={lang} doc={doc} path="/privacy" navLabel={tr.footer.privacy} />
