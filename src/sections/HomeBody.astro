---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import { type Locale } from '../config/site';
import { t } from '../i18n';
import { organizationLd, softwareAppLd, faqLd, howToLd } from '../lib/seo';

interface Props { lang: Locale }
const { lang } = Astro.props;
const tr = t(lang);
const jsonLd = [organizationLd(), softwareAppLd(), howToLd(tr.home.howTitle, tr.home.steps), faqLd(tr.faqHome)];
---
<Base title={tr.home.metaTitle} description={tr.home.metaDescription} lang={lang} path="/" jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="container-page grid items-center gap-14 pb-16 pt-14 md:grid-cols-[1.1fr_0.9fr] md:pb-24 md:pt-20">
    <div>
      <span class="label-mono inline-flex items-center gap-2 rounded-full border border-line-strong px-3 py-1.5">{tr.home.heroKicker}</span>
      <h1 class="mt-5 font-display text-[2.4rem] font-extrabold leading-[1.08] tracking-tight md:text-5xl">
        {tr.home.heroTitleA} <span class="text-accent">{tr.home.heroTitleAccent}</span>
      </h1>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-ink-soft">{tr.home.heroSub}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <AppStoreBadge class="px-5 py-3" />
        <a href="#features" class="btn-outline px-6 py-3 text-sm">{tr.home.featuresH}</a>
      </div>
      <p class="mt-6 text-sm text-ink-muted">{tr.home.trust}</p>
    </div>
    <div class="card p-8">
      <p class="label-mono">{tr.home.workflowH}</p>
      <ul class="mt-5 space-y-5">
        {tr.home.workflow.map((w, i) => (
          <li class="flex gap-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent-soft font-display text-sm font-bold text-accent">{i + 1}</span>
            <div>
              <p class="font-bold">{w.name}</p>
              <p class="mt-1 text-sm text-ink-soft">{w.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Features grid -->
  <section id="features" class="container-page py-16 md:py-20">
    <div class="text-center">
      <h2 class="font-display text-3xl font-extrabold md:text-4xl">{tr.home.featuresH}</h2>
      <p class="mx-auto mt-3 max-w-xl text-ink-soft">{tr.home.featuresSub}</p>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {tr.home.features.map((f) => (
        <div class="card reveal p-6">
          <p class="font-display text-lg font-bold">{f.name}</p>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">{f.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- How it works -->
  <section class="border-y border-line bg-bg-sunken/60 py-16 md:py-20">
    <div class="container-page">
      <div class="text-center">
        <h2 class="font-display text-3xl font-extrabold md:text-4xl">{tr.home.howTitle}</h2>
        <p class="mx-auto mt-3 max-w-xl text-ink-soft">{tr.home.howSub}</p>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {tr.home.steps.map((s, i) => (
          <div class="card reveal p-7" style={`animation-delay:${i * 80}ms`}>
            <span class="label-mono text-accent">{`0${i + 1}`}</span>
            <p class="mt-3 font-semibold leading-snug">{s}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Faq faqs={tr.faqHome} title={tr.faqHeading} />

  <!-- Final CTA -->
  <section class="container-page py-20 md:py-24">
    <div class="rounded-card border border-line bg-bg-raised px-8 py-16 text-center md:py-20">
      <h2 class="mx-auto max-w-2xl font-display text-3xl font-extrabold md:text-5xl">{tr.home.finalH}</h2>
      <p class="mx-auto mt-4 max-w-md text-ink-soft">{tr.home.finalSub}</p>
      <div class="mt-8 flex justify-center"><AppStoreBadge /></div>
    </div>
  </section>
</Base>
