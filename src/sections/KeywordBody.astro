---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import { BRAND, type Locale } from '../config/site';
import { lp, t } from '../i18n';
import { keywordAlternates, type KeywordPage, type KeywordTopicId } from '../i18n/keywords';
import { faqLd, breadcrumbLd } from '../lib/seo';

interface Props {
  lang: Locale;
  topic: KeywordTopicId;
  page: KeywordPage;
}
const { lang, topic, page } = Astro.props;
const tr = t(lang);
const altLocales = keywordAlternates(topic).map((a) => a.lang);
const jsonLd = [
  faqLd(page.faqs),
  breadcrumbLd([
    { name: BRAND.name, path: lp(lang, '/') },
    { name: page.h1, path: lp(lang, `/${page.slug}`) },
  ]),
];
---
<Base
  title={page.metaTitle}
  description={page.metaDescription}
  lang={lang}
  path={`/${page.slug}`}
  jsonLd={jsonLd}
  altLocales={altLocales}
>
  <article class="container-page max-w-3xl py-16 md:py-20">
    <h1 class="font-display text-4xl font-extrabold leading-tight md:text-5xl">{page.h1}</h1>
    <p class="mt-5 text-lg leading-relaxed text-ink-soft">{page.intro}</p>
    <div class="mt-7"><AppStoreBadge /></div>

    {page.sections.map((s) => (
      <Fragment>
        <h2 class="mt-10 font-display text-xl font-bold">{s.h}</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">{s.p}</p>
      </Fragment>
    ))}

    <h2 class="mt-10 font-display text-xl font-bold">{page.bulletsHeading}</h2>
    <ul class="mt-3 list-disc space-y-1.5 pl-6 text-ink-soft">
      {page.bullets.map((b) => (<li>{b}</li>))}
    </ul>

    <div class="mt-12 rounded-card border border-line bg-bg-raised p-8 text-center">
      <p class="font-display text-xl font-bold">{page.cta}</p>
      <div class="mt-5 flex justify-center"><AppStoreBadge /></div>
    </div>
  </article>

  <Faq faqs={page.faqs} title={tr.faqHeading} />
</Base>
